    </include>
    <include>
      <uri>model://grass_patch</uri>
      <name>grass_5_3</name>
      <pose>16 6 0 0 0 0.0000</pose>
    </include>
    <include>
      <uri>model://grass_patch</uri>
      <name>grass_6_0</name>
      <pose>20 -6 0 0 0 3.1416</pose>
    </include>
    <include>
