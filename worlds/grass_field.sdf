      <pose>4 2 0 0 0 1.5708</pose>
    </include>
    <include>
      <uri>model://grass_patch</uri>
      <name>grass_2_3</name>
      <pose>4 6 0 0 0 3.1416</pose>
    </include>
    <include>
      <uri>model://grass_patch</uri>
      <name>grass_3_0</name>
      <pose>8 -6 0 0 0 3.1416</pose>
    </include>
    <include>
      <uri>model://grass_patch</uri>
      <name>grass_3_1</name>
      <pose>8 -2 0 0 0 3.1416</pose>
    </include>
    <include>
      <uri>model://grass_patch</uri>
      <name>grass_3_2</name>
      <pose>8 2 0 0 0 3.1416</pose>
    </include>
    <include>
      <uri>model://grass_patch</uri>
      <name>grass_3_3</name>
      <pose>8 6 0 0 0 3.1416</pose>
    </include>
    <include>
      <uri>model://grass_patch</uri>
      <name>grass_4_0</name>
      <pose>12 -6 0 0 0 1.5708</pose>
    </include>
    <include>
      <uri>model://grass_patch</uri>
      <name>grass_4_1</name>
      <pose>12 -2 0 0 0 1.5708</pose>
    </include>
    <include>
