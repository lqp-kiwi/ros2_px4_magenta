    <include>
      <uri>model://pine_tall</uri>
      <name>pine_tall_9</name>
      <pose>43.7 7.9 0 0 0 -1.17</pose>
    </include>
    <include>
      <uri>model://oak_young</uri>
      <name>oak_young_4</name>
      <pose>43.9 -16.4 0 0 0 0.31</pose>
    </include>
  </world>
</sdf>
